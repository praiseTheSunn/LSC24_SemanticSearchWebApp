# Use NVIDIA’s lightweight Python + CUDA base image for GPU support
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv git && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements first to leverage Docker layer caching
COPY requirements.txt .

# Install Python dependencies (with GPU support if available)
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements.txt

# Copy app source code
COPY main/ /app/
COPY khang.sh /app/

# Make khang.sh executable
RUN chmod +x /app/khang.sh

# Environment variable for system config
ENV SYSTEM_CONFIG="/app/configs/system_config.yaml"

# Expose the port used by the app
EXPOSE 20736

# Ensure the container uses bash for entrypoint
SHELL ["/bin/bash", "-c"]

# Default command
CMD ["bash", "khang.sh"]
